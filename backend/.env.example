# Example backend config — copy to .env and adjust
APP_NAME=BISense AI
ENV=development

# --- security ---
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW=60

# --- database ---
# Postgres + pgvector (used by docker-compose). SQLite fallback if commented.
#DATABASE_URL=postgresql+psycopg2://bisense:bisense@localhost:5432/bisense
DATABASE_URL=sqlite:///./bisense.db

# --- LLM (Member 2) ---
#OPENAI_API_KEY=sk-...
#LLM_MODEL=gpt-4o-mini
#LLM_BASE_URL=
#GROQ_API_KEY=gsk_...              # For Groq (llama-3.3-70b-versatile)
#GROQ_MODEL=llama-3.3-70b-versatile

# --- RAG (Member 3) ---
#EMBEDDER=sentence-transformers   # heavy; default 'tfidf' works offline
TOP_K=6
RERANK_TOP_K=4

# --- Vision (Member 4) ---
#OCR_ENGINE=tesseract             # auto | tesseract | paddle | none